# API для приёма заявок. URL Webhook из n8n или ваш backend.
# Локальный n8n (после импорта workflow и активации): http://localhost:5678/webhook/lead
VITE_LEAD_API=http://localhost:5678/webhook/lead

# YandexGPT API для AI-ассистента и AI-генератора ТЗ (серверные переменные для Vercel /api/assistant)
# Ключи без префикса VITE_ остаются только на сервере и не попадают в браузер.
# YANDEX_FOLDER_ID=
# YANDEX_API_KEY=
# YANDEX_IAM_TOKEN=
# YANDEX_GPT_MODEL=yandexgpt-lite
# YANDEX_GPT_MODEL_URI=gpt://<folder_id>/yandexgpt-lite/latest

# Опционально (только для локальной разработки без серверного прокси):
# VITE_YANDEX_FOLDER_ID=
# VITE_YANDEX_API_KEY=
# VITE_YANDEX_IAM_TOKEN=
# VITE_YANDEX_GPT_MODEL=yandexgpt-lite

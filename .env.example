# ==============================================================================
# 1. РОССИЙСКИЙ ПРОДАКШН-СЕРВЕР И ЛОКАЛЬНОЕ ХРАНЕНИЕ ДАННЫХ (152-ФЗ РФ)
# ==============================================================================
PORT=3000
LEADS_DATA_DIR=./data

# Секретный ключ для скачивания таблицы всех заявок в Excel (CSV) по адресу:
# https://vozduh-nsk54.ru/api/leads-export?key=ВАШ_СЕКРЕТНЫЙ_КЛЮЧ
ADMIN_EXPORT_KEY=change-this-secret-key-for-export

# ==============================================================================
# 2. ИНТЕГРАЦИЯ С CRM / n8n / TELEGRAM (НА СЕРВЕРЕ)
# ==============================================================================
# Серверный URL вебхука вашей российской CRM (Битрикс24 / amoCRM / локальный n8n):
# LEAD_API_URL=http://localhost:5678/webhook/lead
# LEAD_WEBHOOK_SECRET=

# Опционально: мгновенное дублирование всех заявок в Telegram-чат руководителя:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ==============================================================================
# 3. YANDEX GPT API (Яндекс Облако, дата-центры в РФ)
# ==============================================================================
# YANDEX_FOLDER_ID=
# YANDEX_API_KEY=
# YANDEX_IAM_TOKEN=
# YANDEX_GPT_MODEL=yandexgpt-lite
# YANDEX_GPT_MODEL_URI=gpt://<folder_id>/yandexgpt-lite/latest

# ==============================================================================
# 1. ПРИЁМ И СОХРАНЕНИЕ ЗАЯВОК (/api/lead -> n8n / CRM / Telegram)
# ==============================================================================
# Рекомендуемый серверный URL вебхука (не виден в браузере, используется в /api/lead):
# LEAD_API_URL=https://your-n8n-domain/webhook/lead
# LEAD_WEBHOOK_SECRET=

# Прямой URL вебхука (для локальной разработки или прямой отправки):
VITE_LEAD_API=http://localhost:5678/webhook/lead

# Опционально: мгновенное дублирование всех заявок в Telegram-чат руководителя/инженера:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ==============================================================================
# 2. YANDEX GPT API (AI-консультант и AI-генератор ТЗ через /api/assistant)
# ==============================================================================
# Серверные переменные (без префикса VITE_ — надёжно скрыты от браузера):
# YANDEX_FOLDER_ID=
# YANDEX_API_KEY=
# YANDEX_IAM_TOKEN=
# YANDEX_GPT_MODEL=yandexgpt-lite
# YANDEX_GPT_MODEL_URI=gpt://<folder_id>/yandexgpt-lite/latest

# Опционально (только для локальной разработки без серверного прокси):
# VITE_YANDEX_FOLDER_ID=
# VITE_YANDEX_API_KEY=
# VITE_YANDEX_IAM_TOKEN=
# VITE_YANDEX_GPT_MODEL=yandexgpt-lite
